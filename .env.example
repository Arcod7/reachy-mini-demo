# Copy to .env (git-ignored) and fill in; the scripts in scripts/ load it automatically.
# SSH password of the robot's "pollen" user (install.sh, run_companion.sh, shutdown.sh)
ROBOT_PASSWORD="change-me"
# Password of the robot's own setup hotspot "reachy-mini-ap" (wifi_setup.sh)
REACHY_AP_PASSWORD="change-me"
# Optional: where the robot is (default pollen@reachy-mini.local)
#ROBOT=pollen@reachy-mini.local
