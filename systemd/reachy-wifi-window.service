[Unit]
Description=Reachy Mini: switch the hotspot Wi-Fi and Bluetooth off 15 min after boot or after the last connection (never on a normal network)
After=NetworkManager.service
# The daemon brings the hotspot up at start; the radio must be on by then.
Before=reachy-mini-daemon.service

[Service]
Type=simple
# WIFI_WINDOW_S (default 900) comes from `export WIFI_WINDOW_S=` in /home/pollen/.zshrc (0 disables).

# NetworkManager remembers "radio off" across reboots, so every boot starts by turning it back on.
ExecStartPre=/usr/bin/nmcli radio wifi on
ExecStart=/usr/local/sbin/reachy-wifi-window

[Install]
WantedBy=multi-user.target
